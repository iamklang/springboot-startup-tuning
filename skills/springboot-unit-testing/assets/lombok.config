# Marks Lombok-generated methods with @lombok.Generated (CLASS retention), which JaCoCo and PIT skip.
# Put this file at the project root (or the module root). Rebuild, then check the JaCoCo report:
# getters/setters of @Getter/@Setter/@Data classes should no longer appear as missed lines.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
