<!--
  Test-quality tooling for Maven. Verified with Spring Boot 3.5.7 (JUnit 5.12) and 4.1.3 (JUnit 6.0),
  JDK 21 and 24, Maven 3.9: JaCoCo 0.8.16, PIT 1.30.2, pitest-junit5-plugin 1.2.3.

  1. Merge the <properties> entries into the project's <properties>.
     If the project already sets <argLine>, keep its value and put @{argLine} in front of it.
  2. Add the four plugins to <build><plugins>. If the project already configures surefire,
     merge the <argLine> into the existing configuration instead of adding a second plugin.
  3. Set pit.targetClasses to the application's base package (for several packages, add params).

  Commands
    mvn test                         tests + JaCoCo report (target/site/jacoco/jacoco.xml)
    mvn verify                       + coverage gate (fails below coverage.minimum)
    mvn test-compile org.pitest:pitest-maven:mutationCoverage
                                     mutation run + gate (target/pit-reports/mutations.xml)
    ... -Dpit.targetClasses=com.x.Foo -DtargetTests='com.x.Foo*Test' -Dmutation.minimum=0
                                     one class while working; the threshold must be overridden through
                                     the property (-DmutationThreshold=0 does not beat the explicit config)
  Run PIT after test-compile in the same command: the Mockito agent path is set by
  maven-dependency-plugin during the build, so a bare "mvn org.pitest:...:mutationCoverage" fails
  with "Error opening zip file ... ${org.mockito:mockito-core:jar}".
-->

<!-- 1. properties -->
<jacoco.version>0.8.16</jacoco.version>
<pitest.version>1.30.2</pitest.version>
<pitest-junit5.version>1.2.3</pitest-junit5.version>
<coverage.minimum>0.95</coverage.minimum>
<mutation.minimum>95</mutation.minimum>
<pit.targetClasses>com.example.*</pit.targetClasses>   <!-- the application's base package -->
<!-- empty default so @{argLine} resolves when JaCoCo is skipped (-Djacoco.skip=true) -->
<argLine/>

<!-- 2. plugins -->
<!-- test-quality: begin -->
<plugin>
  <!-- sets ${org.mockito:mockito-core:jar} to the jar path, for the Mockito agent below -->
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-dependency-plugin</artifactId>
  <executions><execution><goals><goal>properties</goal></goals></execution></executions>
</plugin>
<plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-surefire-plugin</artifactId>
  <configuration>
    <!-- @{argLine} = JaCoCo agent (late-bound). Mockito as an agent: JDK 21+ warns about, and later
         JDKs refuse, dynamic self-attach. -Xshare:off silences the CDS warning that agents cause. -->
    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
  </configuration>
</plugin>
<plugin>
  <groupId>org.jacoco</groupId>
  <artifactId>jacoco-maven-plugin</artifactId>
  <version>${jacoco.version}</version>
  <configuration>
    <excludes>
      <!-- only code nobody writes logic in; every entry needs the user's approval -->
      <exclude>**/*Application.class</exclude>
    </excludes>
  </configuration>
  <executions>
    <execution><id>prepare-agent</id><goals><goal>prepare-agent</goal></goals></execution>
    <execution><id>report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
    <execution>
      <!-- on verify, not test: "mvn test" must stay usable while coverage is still below target -->
      <id>check</id><phase>verify</phase><goals><goal>check</goal></goals>
      <configuration>
        <rules><rule><element>BUNDLE</element><limits>
          <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${coverage.minimum}</minimum></limit>
          <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${coverage.minimum}</minimum></limit>
        </limits></rule></rules>
      </configuration>
    </execution>
  </executions>
</plugin>
<plugin>
  <groupId>org.pitest</groupId>
  <artifactId>pitest-maven</artifactId>
  <version>${pitest.version}</version>
  <dependencies>
    <dependency>
      <groupId>org.pitest</groupId>
      <artifactId>pitest-junit5-plugin</artifactId>
      <version>${pitest-junit5.version}</version>
    </dependency>
  </dependencies>
  <configuration>
    <targetClasses><param>${pit.targetClasses}</param></targetClasses>
    <excludedClasses><param>**.*Application</param></excludedClasses>
    <!-- Spring context tests are slow per mutant and can hide mutants in a cached context -->
    <excludedTestClasses><param>**.*IT</param><param>**.*IntegrationTest</param></excludedTestClasses>
    <mutators><mutator>DEFAULTS</mutator></mutators>
    <mutationThreshold>${mutation.minimum}</mutationThreshold>
    <outputFormats><param>XML</param><param>HTML</param></outputFormats>
    <timestampedReports>false</timestampedReports>
    <features><feature>+auto_threads</feature></features>
    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
  </configuration>
</plugin>
<!-- test-quality: end -->
